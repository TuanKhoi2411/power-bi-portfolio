table FactMarketing
	lineageTag: b074df67-e7c3-4d6d-9a28-8b347e583519

	measure Contacts = COUNTROWS ( FactMarketing )
		formatString: #,0
		displayFolder: Marketing\Core
		lineageTag: 17306521-a8c0-4a97-8d2d-d9b58f2715f2

	measure Conversions = SUM ( FactMarketing[Converted] )
		formatString: #,0
		displayFolder: Marketing\Core
		lineageTag: 7cca8780-7f85-4f83-bd75-04a14626b759

	measure 'Conversion Rate' = DIVIDE ( [Conversions], [Contacts] )
		formatString: 0.0%
		displayFolder: Marketing\Core
		lineageTag: 81b18793-1346-41d1-b016-8eb1a069867b

	measure 'Average Contact Duration' = AVERAGE ( FactMarketing[DurationSeconds] )
		formatString: #,0 "sec"
		displayFolder: Marketing\Engagement
		lineageTag: dd8358e8-a81a-4bb5-a4e8-9623084614ed

	measure 'Average Campaign Contacts' = AVERAGE ( FactMarketing[CampaignContacts] )
		formatString: 0.00
		displayFolder: Marketing\Efficiency
		lineageTag: 2e52a116-928d-46d5-a742-f44e666ea6b8

	measure 'Prior Contact Rate' = DIVIDE ( CALCULATE ( [Contacts], FactMarketing[PriorContacts] > 0 ), [Contacts] )
		formatString: 0.0%
		displayFolder: Marketing\Audience
		lineageTag: 973db1e5-ba38-42f7-99cd-7afdeedb2b37

	measure 'Cellular Contact Share' = DIVIDE ( CALCULATE ( [Contacts], FactMarketing[ContactChannel] = "cellular" ), [Contacts] )
		formatString: 0.0%
		displayFolder: Marketing\Channel
		lineageTag: 10a8922d-37e4-492b-935b-f33ca0468d70

	measure 'Successful Prior Outcome Rate' = DIVIDE ( CALCULATE ( [Contacts], FactMarketing[PriorOutcome] = "success" ), [Contacts] )
