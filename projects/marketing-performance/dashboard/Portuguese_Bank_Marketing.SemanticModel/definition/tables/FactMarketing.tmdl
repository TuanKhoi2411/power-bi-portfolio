		lineageTag: 6562bed7-7110-4003-b82d-fe231b3b7186

	measure 'Conversion Rate Previous Month' = VAR CurrentMonth = MAX ( FactMarketing[CampaignMonthNumber] ) RETURN CALCULATE ( [Conversion Rate], REMOVEFILTERS ( FactMarketing[CampaignMonth], FactMarketing[CampaignMonthNumber], FactMarketing[CampaignDate] ), FactMarketing[CampaignMonthNumber] = CurrentMonth - 1 )
		formatString: 0.0%
