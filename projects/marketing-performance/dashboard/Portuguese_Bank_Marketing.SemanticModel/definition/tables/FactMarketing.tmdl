		lineageTag: a357c02f-6766-40e3-a870-09e75328e118

	measure 'Conversions per 1K Contacts' = DIVIDE ( [Conversions] * 1000, [Contacts] )
		formatString: #,0.0
		displayFolder: Marketing\Efficiency
		lineageTag: 47539b1f-8a08-498d-b3ff-53b88e5914c2

	measure 'Contacts Previous Month' = VAR CurrentMonth = MAX ( FactMarketing[CampaignMonthNumber] ) RETURN CALCULATE ( [Contacts], REMOVEFILTERS ( FactMarketing[CampaignMonth], FactMarketing[CampaignMonthNumber], FactMarketing[CampaignDate] ), FactMarketing[CampaignMonthNumber] = CurrentMonth - 1 )
		formatString: #,0
		displayFolder: Marketing\Movement
		lineageTag: a03b3059-155a-4837-a328-20672bc24e33

	measure 'Contacts MoM' = DIVIDE ( [Contacts] - [Contacts Previous Month], [Contacts Previous Month] )
