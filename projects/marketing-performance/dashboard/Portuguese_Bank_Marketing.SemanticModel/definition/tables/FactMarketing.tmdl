		displayFolder: Marketing\Movement
		lineageTag: 53fbd2c8-04a3-4e6a-b5aa-452362092156

	measure 'Conversions Previous Month' = VAR CurrentMonth = MAX ( FactMarketing[CampaignMonthNumber] ) RETURN CALCULATE ( [Conversions], REMOVEFILTERS ( FactMarketing[CampaignMonth], FactMarketing[CampaignMonthNumber], FactMarketing[CampaignDate] ), FactMarketing[CampaignMonthNumber] = CurrentMonth - 1 )
		formatString: #,0
		displayFolder: Marketing\Movement
