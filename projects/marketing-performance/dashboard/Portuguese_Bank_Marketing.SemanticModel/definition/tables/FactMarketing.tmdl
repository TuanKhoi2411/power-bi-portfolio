		displayFolder: Marketing\Movement
		lineageTag: 2606a67c-8604-444a-877a-1f2f978a34e8

	measure 'Average Duration Previous Month' = VAR CurrentMonth = MAX ( FactMarketing[CampaignMonthNumber] ) RETURN CALCULATE ( [Average Contact Duration], REMOVEFILTERS ( FactMarketing[CampaignMonth], FactMarketing[CampaignMonthNumber], FactMarketing[CampaignDate] ), FactMarketing[CampaignMonthNumber] = CurrentMonth - 1 )
		formatString: #,0 "sec"
