Latest Month Conversion Rate =
VAR ReviewableMonths = FILTER ( ALL ( DimDate[MonthNumber] ), CALCULATE ( [Contacts] ) >= 500 ) VAR M = MAXX ( ReviewableMonths, DimDate[MonthNumber] ) RETURN CALCULATE ( [Conversion Rate], REMOVEFILTERS ( DimDate ), DimDate[MonthNumber] = M )
		formatString: 0.0%
		displayFolder: Marketing\Movement
		lineageTag: 44f77516-60be-41dd-ac80-02c6ade516e3

Prior Month Conversion Rate =
VAR ReviewableMonths = FILTER ( ALL ( DimDate[MonthNumber] ), CALCULATE ( [Contacts] ) >= 500 ) VAR M = MAXX ( ReviewableMonths, DimDate[MonthNumber] ) VAR PriorM = MAXX ( FILTER ( ReviewableMonths, DimDate[MonthNumber] < M ), DimDate[MonthNumber] ) RETURN CALCULATE ( [Conversion Rate], REMOVEFILTERS ( DimDate ), DimDate[MonthNumber] = PriorM )
		formatString: 0.0%
		displayFolder: Marketing\Movement
		lineageTag: 1feaa1c2-88d0-4421-854c-e92d6a65bf62

Latest Conversion Rate Variance pp =
[Latest Month Conversion Rate] - [Prior Month Conversion Rate]
		formatString: +0.0%;-0.0%;0.0%
