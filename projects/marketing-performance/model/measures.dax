Conversion Rate Change Display =
VAR Delta = [Conversion Rate Variance pp] RETURN SWITCH ( TRUE (), ISBLANK ( [Conversion Rate Previous Month] ), "No prior month", Delta > 0, "▲ " & FORMAT ( ABS ( Delta ) * 100, "0.0" ) & " pp", Delta < 0, "▼ " & FORMAT ( ABS ( Delta ) * 100, "0.0" ) & " pp", "— 0.0 pp" )
		displayFolder: Marketing\Display
		lineageTag: 22b0f588-aada-4cd0-a4ed-4fb631ce375e

