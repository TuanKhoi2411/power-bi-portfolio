Low Recovery Exposure MoM =
VAR LastMonth = MAXX ( FILTER ( ALLSELECTED ( DimDate[MonthStart] ), CALCULATE ( [Low Recovery Exposure] ) > 0 ), DimDate[MonthStart] ) VAR CurrentValue = CALCULATE ( [Low Recovery Exposure], REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], LastMonth, EOMONTH ( LastMonth, 0 ) ) ) VAR PreviousValue = CALCULATE ( [Low Recovery Exposure], REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], EOMONTH ( LastMonth, -2 ) + 1, EOMONTH ( LastMonth, -1 ) ) ) RETURN DIVIDE ( CurrentValue - PreviousValue, PreviousValue )
