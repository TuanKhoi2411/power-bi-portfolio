		displayFolder: Risk\Rules
		lineageTag: e0b968e8-4c2f-43bc-b093-923abbfa68e5

60M Bad Loan Rate =
CALCULATE ( [Bad Loan Rate], KEEPFILTERS ( FactLoans[TermMonths] = 60 ) )
