Borrowers MoM =
VAR AnchorDate = MAXX ( ALLSELECTED ( DimDate[Date] ), DimDate[Date] ) VAR CurrentValue = CALCULATE ( [Borrowers], REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], EOMONTH ( AnchorDate, -1 ) + 1, EOMONTH ( AnchorDate, 0 ) ) ) VAR PreviousValue = CALCULATE ( [Borrowers], REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], EOMONTH ( AnchorDate, -2 ) + 1, EOMONTH ( AnchorDate, -1 ) ) ) RETURN DIVIDE ( CurrentValue - PreviousValue, PreviousValue )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Movement
		lineageTag: a44ff455-4ef4-4690-80f7-20f53dc9cab2

