		displayFolder: Risk\Rules
		lineageTag: 2c231b10-44fc-4e9a-a1a5-1d3d95c9b76e

Recovery Target Gap =
[Recovery Rate] - 0.70
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Recovery\Variance
		lineageTag: beceadd1-2c33-466c-a22c-eeeeec847f7e

Verification Bad Rate Gap =
VAR VerifiedRate = CALCULATE ( [Bad Loan Rate], KEEPFILTERS ( FactLoans[IncomeVerification] = "Verified" ) ) VAR NotVerifiedRate = CALCULATE ( [Bad Loan Rate], KEEPFILTERS ( FactLoans[IncomeVerification] = "Not Verified" ) ) RETURN VerifiedRate - NotVerifiedRate
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Borrower Risk
		lineageTag: 0f46ee1c-e106-4493-8f6b-87dba47299d1

Expected Loss =
SUMX ( FILTER ( FactLoans, FactLoans[LoanLabel] = "Bad" ), VAR Unrecovered = FactLoans[FundedAmount] - FactLoans[TotalPayments] RETURN IF ( Unrecovered > 0, Unrecovered, 0 ) )
		formatString: $#,0
		displayFolder: Recovery\Exposure
		lineageTag: 8400a71a-6d7b-4ec1-bcdf-b082bda762d4

