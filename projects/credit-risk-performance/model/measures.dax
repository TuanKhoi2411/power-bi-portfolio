Low Recovery Exposure =
SUMX ( FILTER ( FactLoans, FactLoans[PctLoanAge] > 0.4 && FactLoans[RecoveryRate] < 0.4 ), VAR UnrecoveredFunding = FactLoans[FundedAmount] - FactLoans[TotalPayments] RETURN IF ( UnrecoveredFunding > 0, UnrecoveredFunding, 0 ) )
		formatString: $#,0
		displayFolder: Recovery\Exposure
		lineageTag: 192dd97d-c255-446c-b0fe-77daa7d8bb5b

High Risk Rule Loans =
CALCULATE ( [Loan Applications], KEEPFILTERS ( FactLoans[RiskRule] = "High Risk Rule" ) )
		formatString: #,0
		displayFolder: Risk\Rules
		lineageTag: b1213ddc-965d-49fd-857b-ca03fe3224c2

High Risk Rule Rate =
