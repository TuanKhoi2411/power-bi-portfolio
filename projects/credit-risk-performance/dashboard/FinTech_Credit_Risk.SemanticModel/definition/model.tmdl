model FinTechCreditRisk
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["FactLoans","RiskDriverImportance","RiskRuleSummary","DimGrade","DimPurpose","DimState","DimIncomeBand","DimIncomeLevel","DimLoanLabel","DimHomeOwnership","DimTerm"]

annotation PBI_ProTooling = ["DevMode"]

ref table FactLoans
ref table DimDate
ref table Measure
ref table RiskDriverImportance
ref table RiskRuleSummary
ref table DimGrade
ref table DimPurpose
ref table DimState
ref table DimIncomeBand
ref table DimIncomeLevel
ref table DimLoanLabel
ref table DimHomeOwnership
ref table DimTerm

ref cultureInfo en-US

