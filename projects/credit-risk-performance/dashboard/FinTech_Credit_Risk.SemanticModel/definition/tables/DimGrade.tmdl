table DimGrade
	lineageTag: 9ee2bd47-41b4-45ed-bf66-c99d3e64c101

	column GradeKey
		dataType: string
		isKey
		lineageTag: 9ee2bd47-41b4-45ed-bf66-c99d3e64c102
		summarizeBy: none
		sourceColumn: [GradeKey]

	column Grade
		dataType: string
