Quarterly Operating Income Previous Year =
VAR CurrentFrame = CALCULATE ( SELECTEDVALUE ( FactFinance[Frame] ), FactFinance[DisplayMetric] = "Operating Income", FactFinance[PeriodType] = "Quarter" ) VAR CurrentYear = IF ( NOT ISBLANK ( CurrentFrame ) && CONTAINSSTRING ( CurrentFrame, "Q" ), VALUE ( MID ( CurrentFrame, 3, 4 ) ) ) VAR PriorFrame = IF ( NOT ISBLANK ( CurrentYear ), "CY" & FORMAT ( CurrentYear - 1, "0000" ) & RIGHT ( CurrentFrame, 2 ) ) RETURN IF ( ISBLANK ( PriorFrame ), BLANK (), CALCULATE ( [Quarterly Operating Income], REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( FactFinance[EndDate] ), REMOVEFILTERS ( FactFinance[FiscalYear] ), REMOVEFILTERS ( FactFinance[FiscalPeriod] ), REMOVEFILTERS ( FactFinance[Frame] ), FactFinance[Frame] = PriorFrame ) )
		formatString: $#,0
		displayFolder: Finance\Operating Leverage
		lineageTag: bdfd9dd7-9d3b-4245-b70c-9991ac1c7d58

Quarterly Operating Income YoY =
DIVIDE ( [Quarterly Operating Income] - [Quarterly Operating Income Previous Year], [Quarterly Operating Income Previous Year] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Finance\Operating Leverage
		lineageTag: a4a6c50c-26cf-4991-9469-e320c88be9b7

Operating Leverage Spread =
[Quarterly Operating Income YoY] - [Revenue YoY]
		formatString: +0.0%;-0.0%;0.0%
