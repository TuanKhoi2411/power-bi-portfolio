		lineageTag: d25496e6-e6d8-5603-a758-e9a2cb5c8aec

KPI YoY Color Latest Gross Profit YoY =
VAR V = [Latest Gross Profit YoY] RETURN SWITCH ( TRUE (), ISBLANK ( V ), "#777777", V > 0, "#0F766E", V < 0, "#E05252", "#777777" )
