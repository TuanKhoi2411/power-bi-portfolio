// Display folder: Finance\Movement
// Format string: $#,0
[Latest Cash PY] = VAR D = CALCULATE ( MAX ( FactFinance[EndDate] ), REMOVEFILTERS ( DimDate ), FactFinance[DisplayMetric] = "Cash & Equivalents" ) VAR FY = CALCULATE ( MAX ( FactFinance[FiscalYear] ), REMOVEFILTERS ( DimDate ), FactFinance[EndDate] = D, FactFinance[DisplayMetric] = "Cash & Equivalents" ) VAR FP = CALCULATE ( MAX ( FactFinance[FiscalPeriod] ), REMOVEFILTERS ( DimDate ), FactFinance[EndDate] = D, FactFinance[DisplayMetric] = "Cash & Equivalents" ) VAR PYD = CALCULATE ( MAX ( FactFinance[EndDate] ), REMOVEFILTERS ( DimDate ), FactFinance[FiscalYear] = FY - 1, FactFinance[FiscalPeriod] = FP, FactFinance[DisplayMetric] = "Cash & Equivalents" ) RETURN CALCULATE ( [Cash], REMOVEFILTERS ( DimDate ), FactFinance[EndDate] = PYD )

// Display folder: Finance\Movement
// Format string: +0.0%;-0.0%;0.0%
[Latest Cash YoY] = DIVIDE ( [Latest Cash] - [Latest Cash PY], [Latest Cash PY] )

// Display folder: Finance\Movement
// Format string: 0.0%
[Latest Liabilities to Assets PY] = DIVIDE ( [Latest Liabilities PY], [Latest Assets PY] )

// Display folder: Finance\Movement
// Format string: +0.0%;-0.0%;0.0%
[Latest Liabilities to Assets Variance pp] = [Latest Liabilities to Assets] - [Latest Liabilities to Assets PY]

// Display folder: Finance\Movement
// Format string: 0.0%
[Latest Cash Coverage PY] = DIVIDE ( [Latest Cash PY], [Latest Liabilities PY] )

// Display folder: Finance\Movement
// Format string: +0.0%;-0.0%;0.0%
[Latest Cash Coverage Variance pp] = [Latest Cash Coverage] - [Latest Cash Coverage PY]

// Display folder: Finance\Display
// Format string: 
[KPI Operating Margin Display] = FORMAT ( [Latest Operating Margin], "0.0%" )

// Display folder: Finance\Display
// Format string: 
[KPI Net Margin Display] = FORMAT ( [Latest Net Margin], "0.0%" )

// Display folder: Finance\Display
// Format string: 
[KPI Opex Ratio Display] = FORMAT ( [Latest Operating Expense Ratio], "0.0%" )

// Display folder: Finance\Display
// Format string: 
[KPI Assets Display] = "$" & FORMAT ( DIVIDE ( [Latest Assets], 1000000000 ), "0.0" ) & "B"

// Display folder: Finance\Display
// Format string: 
[KPI Liabilities Display] = "$" & FORMAT ( DIVIDE ( [Latest Liabilities], 1000000000 ), "0.0" ) & "B"

// Display folder: Finance\Display
// Format string: 
[KPI Cash Display] = "$" & FORMAT ( DIVIDE ( [Latest Cash], 1000000000 ), "0.0" ) & "B"

// Display folder: Finance\Display
// Format string: 
[KPI Liabilities to Assets Display] = FORMAT ( [Latest Liabilities to Assets], "0.0%" )

// Display folder: Finance\Display
// Format string: 
[KPI Cash Coverage Display] = FORMAT ( [Latest Cash Coverage], "0.0%" )

