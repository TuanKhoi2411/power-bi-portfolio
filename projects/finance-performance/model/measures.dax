Latest Revenue Component Amount =
SWITCH ( SELECTEDVALUE ( FinanceComponent[Component] ), "Cost of Sales", [Latest Cost of Sales Amount], "Operating Expenses", [Latest Operating Expenses Amount], "Other & Tax", [Latest Other and Tax Amount], "Net Income", [Latest Net Income] )
		formatString: $#,0,,"M"
		displayFolder: Finance\Executive Composition
		lineageTag: ed4f6ab5-b3e7-46ce-b2b6-ae59f9c375c2

Latest Revenue Component Ratio =
DIVIDE ( [Latest Revenue Component Amount], [Latest Revenue] )
		formatString: 0.0%
		displayFolder: Finance\Executive Composition
		lineageTag: fe85dd26-e8b4-4bdb-91ae-b1e1857e858e

Latest Other and Tax Ratio =
DIVIDE ( [Latest Other and Tax Amount], [Latest Revenue] )
		formatString: 0.0%
		displayFolder: Finance\Margins
		lineageTag: 155156ae-9cb1-4e17-b8a6-b23b8b708c32

Header As Of Label =
