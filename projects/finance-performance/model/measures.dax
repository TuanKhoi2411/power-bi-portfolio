		formatString: 0.0%
		displayFolder: Finance\Latest KPIs
		lineageTag: cbcd9a85-ddd1-45c7-9be4-db4ff5367ae6

Revenue Previous Year =
VAR CurrentFrame = CALCULATE ( SELECTEDVALUE ( FactFinance[Frame] ), FactFinance[DisplayMetric] = "Revenue", FactFinance[PeriodType] = "Quarter" ) VAR CurrentYear = IF ( NOT ISBLANK ( CurrentFrame ) && CONTAINSSTRING ( CurrentFrame, "Q" ), VALUE ( MID ( CurrentFrame, 3, 4 ) ) ) VAR PriorFrame = IF ( NOT ISBLANK ( CurrentYear ), "CY" & FORMAT ( CurrentYear - 1, "0000" ) & RIGHT ( CurrentFrame, 2 ) ) RETURN IF ( ISBLANK ( PriorFrame ), BLANK (), CALCULATE ( [Quarterly Revenue], REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( FactFinance[EndDate] ), REMOVEFILTERS ( FactFinance[FiscalYear] ), REMOVEFILTERS ( FactFinance[FiscalPeriod] ), REMOVEFILTERS ( FactFinance[Frame] ), FactFinance[Frame] = PriorFrame ) )
		formatString: $#,0
		displayFolder: Finance\Movement
		lineageTag: 28c748ce-7611-4fd2-bbcc-2129ad2f6e61

Revenue YoY =
VAR CurrentRevenue = [Quarterly Revenue] VAR PriorRevenue = [Revenue Previous Year] RETURN IF ( ISBLANK ( CurrentRevenue ) || ISBLANK ( PriorRevenue ), BLANK (), DIVIDE ( CurrentRevenue - PriorRevenue, PriorRevenue ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Finance\Movement
		lineageTag: a86a4a1d-9985-4048-ba14-12f26dd901ce

Liabilities to Assets =
DIVIDE ( [Liabilities], [Assets] )
		formatString: 0.0%
