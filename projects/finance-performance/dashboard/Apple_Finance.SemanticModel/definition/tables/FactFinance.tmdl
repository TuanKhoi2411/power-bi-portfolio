		lineageTag: 93604975-62d3-42ea-a8ae-e0242f0e6188

	measure 'Latest Operating Income YoY' = DIVIDE ( [Latest Operating Income] - [Latest Operating Income Previous Year], [Latest Operating Income Previous Year] )
