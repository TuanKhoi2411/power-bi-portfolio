		formatString: $#,0
		displayFolder: Finance\Variance
		lineageTag: dc3f855e-f4c4-4bc3-9644-39f6fcc31eb2

	measure 'Latest Net Income YoY' = DIVIDE ( [Latest Net Income] - [Latest Net Income Previous Year], [Latest Net Income Previous Year] )
