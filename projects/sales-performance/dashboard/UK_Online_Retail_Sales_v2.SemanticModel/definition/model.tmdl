model UKOnlineRetailSales
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["FactSales","DimCustomer","DimProduct","DimCountry","DimTransactionType"]

annotation PBI_ProTooling = ["DevMode"]

ref table FactSales
ref table DimDate
ref table DimCustomer
ref table DimProduct
ref table DimCountry
ref table DimTransactionType

ref cultureInfo en-US

