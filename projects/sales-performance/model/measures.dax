		displayFolder: Customer\Core
		lineageTag: 565edaf0-eda6-4d50-b865-4f8b13228f54

Customer Net Sales Coverage =
DIVIDE ( [Customer Identified Net Sales], [Net Sales] )
		formatString: 0.0%
		displayFolder: Customer\Quality
		lineageTag: 6db27e88-41fc-42c1-a775-6713494dbe17

Gross-to-Net Reconciliation Residual =
[Net Sales] - ( [Gross Sales] - [Return Amount] )
		formatString: £#,0;[Red]-£#,0
		displayFolder: Sales\Quality
		lineageTag: 49a82c85-919d-47d8-a535-b9e2a6fd610b

Latest Period Status =
VAR D = MAX ( FactSales[SalesDate] ) RETURN IF ( D < EOMONTH ( D, 0 ), "Partial through " & FORMAT ( D, "dd MMM yyyy" ), "Complete month" )
		displayFolder: Sales\Quality
		lineageTag: 25d29804-0ffb-4866-a391-6fea9a9dc931

Completed Month Net Sales MoM Change =
VAR ContextMonthEnd = EOMONTH ( MAX ( DimDate[Date] ), 0 ) VAR DataMaxDate = CALCULATE ( MAX ( FactSales[SalesDate] ), REMOVEFILTERS ( DimDate ) ) VAR IsPartialLatestMonth = ContextMonthEnd = EOMONTH ( DataMaxDate, 0 ) && DataMaxDate < EOMONTH ( DataMaxDate, 0 ) VAR PreviousMonthSales = CALCULATE ( [Net Sales], DATEADD ( DimDate[Date], -1, MONTH ) ) RETURN IF ( IsPartialLatestMonth || ISBLANK ( PreviousMonthSales ), BLANK (), [Net Sales] - PreviousMonthSales )
		formatString: £#,0
		displayFolder: Sales\Movement
		lineageTag: 122b51df-e637-4cbe-9688-47a85e287680

Top 10 Identified Customer Sales =
SUMX ( TOPN ( 10, FILTER ( ALLSELECTED ( DimCustomer[CustomerKey] ), DimCustomer[CustomerKey] <> "UNKNOWN" ), [Net Sales], DESC ), CALCULATE ( [Net Sales] ) )
		formatString: £#,0
		displayFolder: Customer\Concentration
		lineageTag: db6fa4ee-e27a-45c0-91da-5af787f3fcce

Other Identified Customer Sales =
MAX ( 0, [Customer Identified Net Sales] - [Top 10 Identified Customer Sales] )
		formatString: £#,0
		displayFolder: Customer\Concentration
		lineageTag: e65f82dc-7b14-4945-92e2-a32f1fbc8595

Customer Country Rank =
RANKX ( ALLSELECTED ( DimCountry[Country] ), [Customers],, DESC, DENSE )
		formatString: #,0
		displayFolder: Customer\Ranking
		lineageTag: 20e2ee34-3651-44aa-b140-f52b989c4491

Top 5 Country Customers =
IF ( [Customer Country Rank] <= 5, [Customers] )
		formatString: #,0
		displayFolder: Customer\Ranking
		lineageTag: 02b9edb0-8d95-4865-a0f5-4833e31e5996

UK Net Sales =
CALCULATE ( [Net Sales], REMOVEFILTERS ( DimCountry ), DimCountry[Country] = "United Kingdom" )
		formatString: £#,0
		displayFolder: Sales\Concentration
		lineageTag: 8525d07c-1c66-48d4-bd81-20395a0a5afb

UK Sales Share =
DIVIDE ( [UK Net Sales], CALCULATE ( [Net Sales], REMOVEFILTERS ( DimCountry ) ) )
		formatString: 0.0%
		displayFolder: Sales\Concentration
		lineageTag: 45975acb-7ab6-4555-b031-5ffbda202730

Top 10 Customer Sales Share =
