Average Order Value =
DIVIDE ( [Net Sales], [Orders] )
		formatString: £#,0.00
		displayFolder: Sales\Efficiency
		lineageTag: 99e6af0c-211f-4618-80e1-564be4d9520a

Average Selling Price =
