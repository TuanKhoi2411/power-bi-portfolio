Repeat Customer Net Sales =
SUMX ( FILTER ( VALUES ( DimCustomer[CustomerKey] ), DimCustomer[CustomerKey] <> "UNKNOWN" && CALCULATE ( [Orders] ) > 1 ), CALCULATE ( [Net Sales] ) )
