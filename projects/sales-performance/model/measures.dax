// Auto-exported from the canonical TMDL semantic model.
// Project: sales-performance
// Measure table: FactSales
// Measure count: 74
// Regenerate with scripts/export-model-documentation.ps1 after TMDL changes.

// Display folder: Sales\Core
// Format string: £#,0
[Gross Sales] = SUM ( FactSales[GrossSalesAmount] )

// Display folder: Sales\Core
// Format string: £#,0
[Return Amount] = SUM ( FactSales[ReturnAmount] )

// Display folder: Sales\Core
// Format string: £#,0
[Net Sales] = SUM ( FactSales[NetSalesAmount] )

// Display folder: Sales\Core
// Format string: #,0
[Units Sold] = SUM ( FactSales[UnitsSold] )

// Display folder: Sales\Core
// Format string: #,0
[Returned Units] = SUM ( FactSales[ReturnedUnits] )

// Display folder: Sales\Core
// Format string: #,0
[Orders] = CALCULATE ( DISTINCTCOUNT ( FactSales[InvoiceNo] ), FactSales[IsCancellation] = FALSE () )

// Display folder: Sales\Core
// Format string: #,0
[Customers] = CALCULATE ( DISTINCTCOUNT ( FactSales[CustomerID] ), FactSales[CustomerID] <> "Unknown" )

// Display folder: Sales\Efficiency
// Format string: £#,0.00
[Average Order Value] = DIVIDE ( [Net Sales], [Orders] )

// Display folder: Sales\Efficiency
// Format string: £#,0.00
[Average Selling Price] = DIVIDE ( [Gross Sales], [Units Sold] )

// Display folder: Sales\Quality
// Format string: 0.0%
[Return Rate] = DIVIDE ( [Return Amount], [Gross Sales] )

// Display folder: Sales\Movement
// Format string: £#,0
[Net Sales Previous Month] = VAR MaxSalesDate = MAX ( FactSales[SalesDate] ) VAR CurrentDate = IF ( MaxSalesDate < EOMONTH ( MaxSalesDate, 0 ), EOMONTH ( MaxSalesDate, -1 ), MaxSalesDate ) VAR PreviousDate = EOMONTH ( CurrentDate, -1 ) RETURN CALCULATE ( [Net Sales], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( PreviousDate ) && DimDate[MonthNumber] = MONTH ( PreviousDate ) ) )

// Display folder: Sales\Movement
// Format string: +0.0%;-0.0%;0.0%
[Net Sales MoM] = VAR MaxSalesDate = MAX ( FactSales[SalesDate] ) VAR CurrentDate = IF ( MaxSalesDate < EOMONTH ( MaxSalesDate, 0 ), EOMONTH ( MaxSalesDate, -1 ), MaxSalesDate ) VAR CurrentValue = CALCULATE ( [Net Sales], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( CurrentDate ) && DimDate[MonthNumber] = MONTH ( CurrentDate ) ) ) RETURN DIVIDE ( CurrentValue - [Net Sales Previous Month], [Net Sales Previous Month] )

// Display folder: Sales\Movement
// Format string: £#,0
[Net Sales Previous Year] = CALCULATE ( [Net Sales], DATEADD ( DimDate[Date], -1, YEAR ) )

// Display folder: Sales\Movement
// Format string: +0.0%;-0.0%;0.0%
[Net Sales YoY] = DIVIDE ( [Net Sales] - [Net Sales Previous Year], [Net Sales Previous Year] )

// Display folder: Sales\Movement
// Format string: £#,0
[Gross Sales Previous Month] = VAR MaxSalesDate = MAX ( FactSales[SalesDate] ) VAR CurrentDate = IF ( MaxSalesDate < EOMONTH ( MaxSalesDate, 0 ), EOMONTH ( MaxSalesDate, -1 ), MaxSalesDate ) VAR PreviousDate = EOMONTH ( CurrentDate, -1 ) RETURN CALCULATE ( [Gross Sales], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( PreviousDate ) && DimDate[MonthNumber] = MONTH ( PreviousDate ) ) )

// Display folder: Sales\Movement
// Format string: +0.0%;-0.0%;0.0%
[Gross Sales MoM] = VAR MaxSalesDate = MAX ( FactSales[SalesDate] ) VAR CurrentDate = IF ( MaxSalesDate < EOMONTH ( MaxSalesDate, 0 ), EOMONTH ( MaxSalesDate, -1 ), MaxSalesDate ) VAR CurrentValue = CALCULATE ( [Gross Sales], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( CurrentDate ) && DimDate[MonthNumber] = MONTH ( CurrentDate ) ) ) RETURN DIVIDE ( CurrentValue - [Gross Sales Previous Month], [Gross Sales Previous Month] )

// Display folder: Sales\Movement
// Format string: #,0
[Orders Previous Month] = VAR MaxSalesDate = MAX ( FactSales[SalesDate] ) VAR CurrentDate = IF ( MaxSalesDate < EOMONTH ( MaxSalesDate, 0 ), EOMONTH ( MaxSalesDate, -1 ), MaxSalesDate ) VAR PreviousDate = EOMONTH ( CurrentDate, -1 ) RETURN CALCULATE ( [Orders], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( PreviousDate ) && DimDate[MonthNumber] = MONTH ( PreviousDate ) ) )

