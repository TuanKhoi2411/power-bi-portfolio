Merchandise Net Sales =
CALCULATE ( [Net Sales], FactSales[TransactionType] = "Sale", FactSales[HasValidPrice] = TRUE (), FILTER ( FactSales, VAR ProductName = TRIM ( FactSales[Description] ) VAR ProductCode = UPPER ( TRIM ( FactSales[StockCode] ) ) RETURN LEN ( ProductName ) >= 4 && LEFT ( ProductName, 1 ) <> "?" && LEFT ( ProductName, 1 ) <> "*" && NOT ( ProductCode IN { "POST", "DOT", "M", "BANK CHARGES", "AMAZONFEE", "CRUK", "C2", "D", "PADS" } ) ) )
		formatString: #,0
		displayFolder: Sales\Ranking
		lineageTag: 14241b87-5037-44ed-ae74-c969f1fc3050

Country Sales Rank =
RANKX ( ALLSELECTED ( DimCountry[Country] ), [Net Sales],, DESC, DENSE )
		formatString: #,0
		displayFolder: Sales\Ranking
		lineageTag: 89e0ce87-060a-4a95-91e4-3cdcc4073977

Top 10 Country Net Sales =
IF ( [Country Sales Rank] <= 10, [Net Sales] )
