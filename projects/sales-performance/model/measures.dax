		formatString: £#,0.00
		displayFolder: Sales\Efficiency
		lineageTag: c4168361-8193-49a4-a13b-58b964448647

Return Rate =
DIVIDE ( [Return Amount], [Gross Sales] )
		formatString: 0.0%
		displayFolder: Sales\Quality
		lineageTag: e74fa4ad-bc64-4bcc-a04a-3c500e5e6eba

Net Sales Previous Month =
VAR MaxSalesDate = MAX ( FactSales[SalesDate] ) VAR CurrentDate = IF ( MaxSalesDate < EOMONTH ( MaxSalesDate, 0 ), EOMONTH ( MaxSalesDate, -1 ), MaxSalesDate ) VAR PreviousDate = EOMONTH ( CurrentDate, -1 ) RETURN CALCULATE ( [Net Sales], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( PreviousDate ) && DimDate[MonthNumber] = MONTH ( PreviousDate ) ) )
		formatString: £#,0
		displayFolder: Sales\Movement
		lineageTag: 32cceb3a-dd6c-4940-8f34-78a2c3d6d607

Net Sales MoM =
VAR MaxSalesDate = MAX ( FactSales[SalesDate] ) VAR CurrentDate = IF ( MaxSalesDate < EOMONTH ( MaxSalesDate, 0 ), EOMONTH ( MaxSalesDate, -1 ), MaxSalesDate ) VAR CurrentValue = CALCULATE ( [Net Sales], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( CurrentDate ) && DimDate[MonthNumber] = MONTH ( CurrentDate ) ) ) RETURN DIVIDE ( CurrentValue - [Net Sales Previous Month], [Net Sales Previous Month] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Sales\Movement
		lineageTag: 65f8ce76-0cd9-4596-b196-75b9f6bc2b89

Net Sales Previous Year =
VAR D = MAX ( FactSales[SalesDate] ) VAR PriorStart = DATE ( YEAR ( D ) - 1, MONTH ( D ), 1 ) VAR PriorEnd = IF ( D < EOMONTH ( D, 0 ), DATE ( YEAR ( D ) - 1, MONTH ( D ), DAY ( D ) ), EOMONTH ( PriorStart, 0 ) ) RETURN CALCULATE ( [Net Sales], FILTER ( ALL ( DimDate ), DimDate[Date] >= PriorStart && DimDate[Date] <= PriorEnd ) )
		formatString: £#,0
		displayFolder: Sales\Movement
		lineageTag: c1e34e31-3089-40cc-9678-d2f359a31578

Net Sales YoY =
DIVIDE ( [Net Sales] - [Net Sales Previous Year], [Net Sales Previous Year] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Sales\Movement
		lineageTag: 4871f549-c617-45ed-aa83-2b5818198fcd

Gross Sales Previous Month =
VAR MaxSalesDate = MAX ( FactSales[SalesDate] ) VAR CurrentDate = IF ( MaxSalesDate < EOMONTH ( MaxSalesDate, 0 ), EOMONTH ( MaxSalesDate, -1 ), MaxSalesDate ) VAR PreviousDate = EOMONTH ( CurrentDate, -1 ) RETURN CALCULATE ( [Gross Sales], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( PreviousDate ) && DimDate[MonthNumber] = MONTH ( PreviousDate ) ) )
		formatString: £#,0
		displayFolder: Sales\Movement
		lineageTag: 5cd62187-f607-4197-a81f-23d20f0225eb

