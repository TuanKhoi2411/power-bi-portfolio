Repeat Revenue Share Current Month =
VAR D = CALCULATE ( MAX ( FactSales[SalesDate] ), REMOVEFILTERS ( DimDate ) ) VAR CurrentDate = IF ( D < EOMONTH ( D, 0 ), EOMONTH ( D, -1 ), D ) RETURN CALCULATE ( [Repeat Customer Revenue Share], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( CurrentDate ) && DimDate[MonthNumber] = MONTH ( CurrentDate ) ) )
		formatString: 0.0%
		displayFolder: Customer\Movement
		lineageTag: 87bd2062-fb48-4797-98ad-9b28fdfcd2bb

Repeat Revenue Share Previous Month =
VAR D = CALCULATE ( MAX ( FactSales[SalesDate] ), REMOVEFILTERS ( DimDate ) ) VAR CurrentDate = IF ( D < EOMONTH ( D, 0 ), EOMONTH ( D, -1 ), D ) VAR P = EOMONTH ( CurrentDate, -1 ) RETURN CALCULATE ( [Repeat Customer Revenue Share], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( P ) && DimDate[MonthNumber] = MONTH ( P ) ) )
		formatString: 0.0%
		displayFolder: Customer\Movement
		lineageTag: 6311046d-1344-4c07-bca5-e5e206db0cea

