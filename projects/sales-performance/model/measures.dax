		formatString: 0.0%
		displayFolder: Product\Concentration
		lineageTag: 963eece5-d4e8-4281-81da-4a02840b64b2

Top 10 Product Share Current Month =
VAR D = CALCULATE ( MAX ( FactSales[SalesDate] ), REMOVEFILTERS ( DimDate ) ) VAR CurrentDate = IF ( D < EOMONTH ( D, 0 ), EOMONTH ( D, -1 ), D ) RETURN CALCULATE ( [Top 10 Product Sales Share], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( CurrentDate ) && DimDate[MonthNumber] = MONTH ( CurrentDate ) ) )
		formatString: 0.0%
		displayFolder: Product\Movement
		lineageTag: 557c4784-1890-44e2-a092-aa51723ecda5

Top 10 Product Share Previous Month =
VAR D = CALCULATE ( MAX ( FactSales[SalesDate] ), REMOVEFILTERS ( DimDate ) ) VAR CurrentDate = IF ( D < EOMONTH ( D, 0 ), EOMONTH ( D, -1 ), D ) VAR P = EOMONTH ( CurrentDate, -1 ) RETURN CALCULATE ( [Top 10 Product Sales Share], FILTER ( ALL ( DimDate ), DimDate[Year] = YEAR ( P ) && DimDate[MonthNumber] = MONTH ( P ) ) )
		formatString: 0.0%
		displayFolder: Product\Movement
		lineageTag: ec62a526-620e-416a-a7db-f0b369ff01da

Top 10 Product Share Variance pp =
[Top 10 Product Share Current Month] - [Top 10 Product Share Previous Month]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Product\Movement
		lineageTag: 10ee4b47-64f6-4eec-ab86-d8ceee33f8ce

KPI Top 10 Product Share Display =
FORMAT ( [Top 10 Product Share Current Month], "0.0%" )
		displayFolder: Product\Display
